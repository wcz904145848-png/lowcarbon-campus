* text=auto

# Unity 的 YAML 资产不要做换行转换，否则每台机器提交都会产生全文件 diff
*.unity   -text
*.prefab  -text
*.asset   -text
*.meta    -text
*.mat     -text
*.anim    -text
*.controller -text
*.physicMaterial -text
*.spriteatlas -text

# C#
*.cs text diff=csharp

# 二进制
*.png binary
*.jpg binary
*.jpeg binary
*.psd binary
*.tga binary
*.exr binary
*.wav binary
*.mp3 binary
*.ogg binary
*.fbx binary
*.ttf binary
*.otf binary

# 文档
*.md text
*.json text
